# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development

HOST=0.0.0.0
PORT=3000

# Postgres connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/payplus_dev?schema=public"

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Comma-separated browser origins allowed to call this API.
# Leave empty to reject all cross-origin browser requests.
CORS_ORIGINS=http://localhost:5173

# Reverse proxies in front of the app. 0 = exposed directly, do not trust
# X-Forwarded-For. Set to the real hop count behind nginx/ALB/Cloudflare.
TRUST_PROXY_HOPS=0

# Maximum request body size.
BODY_LIMIT=100kb

# Global rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS per client.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Redis -------------------------------------------------------------------

# redis:// or rediss:// for TLS. Credentials, database index and TLS all come
# from this URL, so it is the single source of truth for the connection.
REDIS_URL=redis://127.0.0.1:6379

# Root of every key this service writes: <prefix>:<NODE_ENV>:...
# Keep it short; the prefix is stored with every key and Redis is in-memory.
REDIS_KEY_PREFIX=payplus

REDIS_CONNECT_TIMEOUT_MS=10000

# Retries per command before it rejects. ioredis defaults to 20, which can pin
# a request for a long time during a failover.
REDIS_MAX_RETRIES_PER_REQUEST=2

# Default cache TTL. Every cache write gets a TTL; there is no unexpiring write.
CACHE_TTL_SECONDS=300

# Bump to retire every cached payload at once, e.g. after changing what is
# cached. Cheaper and safer than scanning to delete.
CACHE_SCHEMA_VERSION=v1

# When the Redis rate-limit store is unreachable: true lets requests through
# unmetered, false returns 500. Availability vs enforcement.
RATE_LIMIT_FAIL_OPEN=true
